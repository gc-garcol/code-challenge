{
  "name": "problem5",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typeorm": "tsx node_modules/typeorm/cli.js",
    "migration:create": "sh -c 'typeorm migration:create src/db/migrations/$0'",
    "migration:generate": "sh -c 'pnpm typeorm migration:generate -d src/db/data-source.ts src/db/migrations/$0'",
    "migration:run": "tsx src/db/migrate.ts run",
    "migration:revert": "tsx src/db/migrate.ts revert",
    "migration:show": "tsx src/db/migrate.ts show",
    "migration:run:prod": "node dist/db/migrate.js run",
    "migration:revert:prod": "node dist/db/migrate.js revert",
    "migration:show:prod": "node dist/db/migrate.js show"
  },
  "packageManager": "pnpm@12.6.0",
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
